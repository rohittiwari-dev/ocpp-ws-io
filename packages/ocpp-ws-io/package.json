{
	"name": "ocpp-ws-io",
	"version": "3.0.3",
	"description": "Type-safe OCPP 1.6J, 2.0.1, and 2.1 WebSocket RPC client & server toolkit for Node.js, TypeScript, and NestJS. OCA schema-validated, Redis clustering, and EV charging infrastructure support.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rohittiwari-dev/ocpp-ws-io.git"
	},
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"typesVersions": {
		"*": {
			"adapters/redis": [
				"dist/adapters/redis.d.ts"
			],
			"browser": [
				"dist/browser.d.ts"
			],
			"logger": [
				"dist/logger.d.ts"
			],
			"plugins": [
				"dist/plugins.d.ts"
			],
			"express": [
				"dist/express.d.ts"
			],
			"nestjs": [
				"dist/nestjs.d.ts"
			],
			"fastify": [
				"dist/fastify.d.ts"
			],
			"hono": [
				"dist/hono.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./adapters/redis": {
			"types": "./dist/adapters/redis.d.ts",
			"import": "./dist/adapters/redis.mjs",
			"require": "./dist/adapters/redis.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.mjs",
			"require": "./dist/browser.js"
		},
		"./logger": {
			"types": "./dist/logger.d.ts",
			"import": "./dist/logger.mjs",
			"require": "./dist/logger.js"
		},
		"./plugins": {
			"types": "./dist/plugins.d.ts",
			"import": "./dist/plugins.mjs",
			"require": "./dist/plugins.js"
		},
		"./express": {
			"types": "./dist/express.d.ts",
			"import": "./dist/express.mjs",
			"require": "./dist/express.js"
		},
		"./nestjs": {
			"types": "./dist/nestjs.d.ts",
			"import": "./dist/nestjs.mjs",
			"require": "./dist/nestjs.js"
		},
		"./fastify": {
			"types": "./dist/fastify.d.ts",
			"import": "./dist/fastify.mjs",
			"require": "./dist/fastify.js"
		},
		"./hono": {
			"types": "./dist/hono.d.ts",
			"import": "./dist/hono.mjs",
			"require": "./dist/hono.js"
		}
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "npm run clean && tsup && node scripts/verify-dist.js",
		"generate": "node scripts/generate-types.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"prepublishOnly": "bun run build",
		"format": "biome format --write",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p test/types-augmented/tsconfig.json"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"keywords": [
		"ocpp",
		"ocpp-rpc",
		"ocpp-j",
		"ocpp1.6",
		"ocpp1.6j",
		"ocpp2.0.1",
		"ocpp2.0.1j",
		"ocpp2.1",
		"websocket",
		"ocpp-websocket",
		"rpc",
		"websocket-rpc",
		"json-rpc",
		"ocpp-client",
		"ocpp-server",
		"charge-point",
		"charging-station",
		"ev-charging",
		"evse",
		"csms",
		"cpo",
		"emsp",
		"wamp",
		"rpc-server",
		"rpc-client",
		"type-safe",
		"typescript",
		"node",
		"nodejs",
		"redis",
		"redis-pubsub",
		"clustering",
		"browser",
		"simulator",
		"ocpp-simulator",
		"testing-cli",
		"ocpp-testing",
		"ocpp-implementation",
		"ocpp-protocol",
		"nestjs",
		"nestjs-ocpp",
		"oca",
		"open-charge-alliance",
		"ocpi",
		"e-mobility",
		"e-mobility-os",
		"citrineos",
		"smart-charging"
	],
	"author": "Rohit Tiwari <rohit@rohittiwari.me>",
	"homepage": "https://ocpp-ws-io.rohittiwari.me",
	"bugs": {
		"url": "https://github.com/rohittiwari-dev/ocpp-ws-io/issues"
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"peerDependencies": {
		"@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
		"express": "^4.21.2 || ^5.0.1",
		"fastify": "^5.12.5",
		"fastify-plugin": "^5.0.0 || ^6.0.0",
		"hono": "^4.12.34",
		"reflect-metadata": "^0.2.2"
	},
	"peerDependenciesMeta": {
		"@nestjs/common": {
			"optional": true
		},
		"@nestjs/core": {
			"optional": true
		},
		"express": {
			"optional": true
		},
		"fastify": {
			"optional": true
		},
		"fastify-plugin": {
			"optional": true
		},
		"hono": {
			"optional": true
		},
		"reflect-metadata": {
			"optional": true
		}
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"voltlog-io": "^1.0.8",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@hono/node-server": "^2.1.3",
		"@nestjs/common": "^12.1.2",
		"@nestjs/core": "^12.1.2",
		"@nestjs/testing": "^12.1.2",
		"@types/express": "^5.0.6",
		"@types/ioredis-mock": "^8.2.8",
		"@types/node": "^20.19.43",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "5.0.3",
		"express": "^5.2.1",
		"fastify": "^5.12.5",
		"fastify-plugin": "^6.0.0",
		"hono": "^4.13.12",
		"ioredis-mock": "^8.13.1",
		"reflect-metadata": "^0.2.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "5.0.3"
	}
}
