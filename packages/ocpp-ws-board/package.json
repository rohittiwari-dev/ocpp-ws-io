{
  "name": "ocpp-ws-board",
  "version": "0.2.0-alpha.0",
  "description": "Monitoring UI and backend integration for ocpp-ws-io. Type-safe TypeScript toolkit for EV charging, CSMS backends, Redis scaling, and protocol validation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohittiwari-dev/ocpp-ws-io.git",
    "directory": "packages/ocpp-ws-board"
  },
  "author": "Rohit Tiwari <rohit@rohittiwari.me>",
  "homepage": "https://ocpp-ws-io.rohittiwari.me",
  "bugs": {
    "url": "https://github.com/rohittiwari-dev/ocpp-ws-io/issues"
  },
  "keywords": [
    "ocpp",
    "ocpp-ui",
    "ocpp-dashboard",
    "ocpp-monitoring",
    "ev-charging",
    "csms",
    "cpo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.cjs",
      "require": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest.d.ts",
      "import": "./dist/nest.cjs",
      "require": "./dist/nest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:ui": "vite build",
    "build:server": "tsup",
    "build": "npm run build:ui && npm run build:server",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.external.json"
  },
  "peerDependencies": {
    "ocpp-ws-io": "^2.3.2"
  },
  "peerDependenciesMeta": {
    "ocpp-ws-io": {
      "optional": false
    }
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tabler/icons-react": "^3.48.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "globals": "^17.13.0",
    "input-otp": "^1.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "vite": "^8.3.2"
  }
}
