{
  "name": "ocpp-ws-cli",
  "version": "1.3.0",
  "description": "The ultimate CLI ecosystem for ocpp-ws-io",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohittiwari-dev/ocpp-ws-io"
  },
  "main": "dist/index.js",
  "bin": {
    "ocpp": "./dist/index.js",
    "ocpp-ws-cli": "./dist/index.js"
  },
  "type": "module",
  "keywords": [
    "ocpp",
    "ocpp-j",
    "ocpp1.6",
    "ocpp2.0.1",
    "simulator",
    "ocpp-simulator",
    "nodejs-library",
    "testing-cli",
    "ocpp-testing",
    "charge-point-simulator",
    "ocpp-implementation",
    "ocpp-docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ocpp-ws-io": "^3.1.0-beta.1"
  },
  "author": "Rohit Tiwari <rohit@rohittiwari.me>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://ocpp-ws-io.rohittiwari.me/docs/cli",
  "bugs": {
    "url": "https://github.com/rohittiwari-dev/ocpp-ws-io/issues"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
