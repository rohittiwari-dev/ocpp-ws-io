{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
    "rootDir": ".",
		"outDir": "dist",
		"types": ["node"]
	},
	"include": ["src"]
}
